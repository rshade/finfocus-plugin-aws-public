{
  "version": 4,
  "terraform_version": "1.5.7",
  "serial": 1,
  "lineage": "fixture-aws_db_instance",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "aws_db_instance",
      "name": "app",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "identifier": "app",
            "instance_class": "db.t3.micro",
            "engine": "postgres",
            "storage_type": "gp3",
            "allocated_storage": 100,
            "multi_az": true,
            "availability_zone": "us-east-1a"
          }
        }
      ]
    }
  ]
}
