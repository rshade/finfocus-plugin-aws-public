{
  "version": 4,
  "terraform_version": "1.5.7",
  "serial": 1,
  "lineage": "fixture-aws_cloudwatch_log_group",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "aws_cloudwatch_log_group",
      "name": "app",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "name": "/app",
            "retention_in_days": 14,
            "region": "us-east-1"
