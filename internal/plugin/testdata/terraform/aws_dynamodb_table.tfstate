{
  "version": 4,
  "terraform_version": "1.5.7",
  "serial": 1,
  "lineage": "fixture-aws_dynamodb_table",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "aws_dynamodb_table",
      "name": "app",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "name": "app",
            "hash_key": "id",
            "billing_mode": "PROVISIONED",
            "read_capacity": 5,
            "write_capacity": 5,
            "region": "us-east-1"
          }
        }
      ]
    }
  ]
}
