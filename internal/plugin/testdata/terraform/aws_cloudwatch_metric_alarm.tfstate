{
  "version": 4,
  "terraform_version": "1.5.7",
  "serial": 1,
  "lineage": "fixture-aws_cloudwatch_metric_alarm",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "aws_cloudwatch_metric_alarm",
      "name": "cpu",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "alarm_name": "cpu",
            "comparison_operator": "GreaterThanThreshold",
            "evaluation_periods": 1,
            "metric_name": "CPUUtilization",
            "namespace": "AWS/EC2",
            "period": 300,
            "statistic": "Average",
            "threshold": 80,
            "region": "us-east-1"
          }
        }
      ]
    }
  ]
}
