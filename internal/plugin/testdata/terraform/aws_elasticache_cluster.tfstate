{
  "version": 4,
  "terraform_version": "1.5.7",
  "serial": 1,
  "lineage": "fixture-aws_elasticache_cluster",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "aws_elasticache_cluster",
      "name": "cache",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "cluster_id": "cache",
            "engine": "redis",
            "node_type": "cache.t3.micro",
            "num_cache_nodes": 2,
            "availability_zone": "us-east-1a"
