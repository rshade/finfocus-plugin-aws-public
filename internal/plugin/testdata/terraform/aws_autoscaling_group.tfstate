{
  "version": 4,
  "terraform_version": "1.5.7",
  "serial": 1,
  "lineage": "fixture-aws_autoscaling_group",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "aws_autoscaling_group",
      "name": "web",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "name": "web",
            "desired_capacity": 3,
            "min_size": 1,
            "max_size": 5,
            "availability_zones": [
              "us-east-1a"
            ],
            "mixed_instances_policy": [
              {
                "launch_template": [
                  {
                    "launch_template_specification": [
                      {
                        "launch_template_id": "lt-123",
                        "version": "$Latest"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
